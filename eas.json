{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "channel": "preview-simulator"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "beta": {
      "extends": "production",
      "environment": "preview",
      "channel": "beta"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796093159"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    },
    "production-closed": {
      "ios": {
        "ascAppId": "6796093159"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
