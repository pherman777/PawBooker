{
  "expo": {
    "name": "PawBooker",
    "slug": "PawBooker",
    "version": "1.0.0",
    "scheme": "pawbooker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.professionalhomebody.PawBooker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B8F72",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.professionalhomebody.PawBooker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PawBooker to access your photos to add a picture of your pet.",
          "cameraPermission": "Allow PawBooker to use your camera to take a picture of your pet."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pawbooker",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6B8F72"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PawBooker to use your location to find groomers near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "441d7057-71d7-4c65-82f6-d31d277c5ec9"
      }
    },
    "owner": "pawbooker"
  }
}
